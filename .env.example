# --- Shopify ---
# Custom app credentials from Shopify Admin > Settings > Apps and sales channels > Develop apps
# (or the Partner Dashboard app you create per the README)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
# Used to verify the authenticity of incoming webhooks (Admin > Develop apps > your app > API credentials)
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- FedEx Developer Portal (developer.fedex.com) ---
FEDEX_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDEX_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDEX_ACCOUNT_NUMBER=xxxxxxxxxx
# Use https://apis-sandbox.fedex.com while testing, https://apis.fedex.com in production
FEDEX_API_BASE=https://apis-sandbox.fedex.com

# Shipper address (your warehouse) FedEx labels ship FROM
SHIPPER_NAME=RCP America
SHIPPER_PHONE=0000000000
SHIPPER_STREET=123 Warehouse Way
SHIPPER_CITY=City
SHIPPER_STATE=ST
SHIPPER_ZIP=00000
SHIPPER_COUNTRY=US

# --- PrintNode (bridges this app to the D450BT on the warehouse computer) ---
PRINTNODE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fill in after installing the PrintNode agent on the warehouse computer and checking
# GET https://api.printnode.com/printers for the D450's printer ID
PRINTNODE_PRINTER_ID=

PORT=3000
